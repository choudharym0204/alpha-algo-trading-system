# Alpha Algo Web — environment configuration (Phase 17)

# Public-only values. NEVER put broker credentials, API secrets, or production
# tokens here — anything prefixed NEXT_PUBLIC_ is shipped to the browser.
# The backend is the authoritative security boundary; these only point the
# browser at the backend, they grant no access.

# REST API base (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# WebSocket base (ws:// or wss://, no trailing slash)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Optional: comma-separated list of enabled nav areas (defaults to all)
# NEXT_PUBLIC_ENABLED_AREAS=dashboard,markets,watchlist,charts,orders,positions,portfolio,pnl,strategies,risk,brokers,reconciliations,settings
