# Alpha Algo Trading System environment template
# Copy this file to .env for local development.
# Keep real secrets out of Git. Never put broker secrets in frontend variables.

# -----------------------------------------------------------------------------
# Runtime identity
# -----------------------------------------------------------------------------
APP_NAME=alpha-algo-trading-system
APP_ENV=development
COMPOSE_PROJECT_NAME=alpha-algo-trading-system
LOG_LEVEL=INFO
STRUCTURED_LOGS=true

# Allowed values: BACKTEST, PAPER, LIVE.
# LIVE must stay disabled until all safety gates are verified.
DEFAULT_TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
REQUIRE_LIVE_CONFIRMATION=true
GLOBAL_TRADING_HALT=true

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
WEB_HOST=0.0.0.0
WEB_PORT=3000
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_WS_BASE_URL=ws://localhost:8000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=alpha_algo
POSTGRES_USER=alpha_algo_app
POSTGRES_PASSWORD=replace-with-local-dev-password
DATABASE_URL=postgresql+psycopg://alpha_algo_app:replace-with-local-dev-password@postgres:5432/alpha_algo
# Connection pool + runtime hardening (Phase 2)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_STARTUP_CHECK_ENABLED=true
DB_STARTUP_CHECK_TIMEOUT_SECONDS=5
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY_SECONDS=0.5
DB_DISPOSE_ON_SHUTDOWN=true
TIMESCALE_ENABLED=true
POSTGRES_TEST_DB=alpha_algo_test
POSTGRES_TEST_USER=alpha_algo_test
POSTGRES_TEST_PASSWORD=replace-with-local-test-password
POSTGRES_TEST_PORT=55432

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_TEST_PORT=56379

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Replace locally with strong generated values. Do not commit real values.
SECRET_KEY=replace-with-generated-secret-key
JWT_ISSUER=alpha-algo-local
JWT_AUDIENCE=alpha-algo-users
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_MINUTES=10080
CREDENTIAL_ENCRYPTION_KEY=replace-with-local-fernet-or-kms-key
PASSWORD_HASH_SCHEME=argon2id
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Only enable when behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# CORS should be narrowed before deployment.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Broker credentials
# -----------------------------------------------------------------------------
# These are placeholders only. Do not commit real broker API keys or tokens.
ZERODHA_API_KEY=replace-with-local-placeholder
ZERODHA_API_SECRET=replace-with-local-placeholder
ZERODHA_ACCESS_TOKEN=replace-with-local-placeholder
UPSTOX_API_KEY=replace-with-local-placeholder
UPSTOX_API_SECRET=replace-with-local-placeholder
UPSTOX_ACCESS_TOKEN=replace-with-local-placeholder

# Broker access remains disabled until broker adapters and safety gates exist.
BROKER_CONNECTIONS_ENABLED=false

# -----------------------------------------------------------------------------
# Market data safety
# -----------------------------------------------------------------------------
MARKET_DATA_ENABLED=false
MARKET_DATA_STALE_AFTER_SECONDS=5
MARKET_DATA_HEARTBEAT_SECONDS=15
MARKET_DATA_RECONNECT_MAX_ATTEMPTS=10
MARKET_DATA_BACKPRESSURE_QUEUE_SIZE=10000

# Market data provider (Phase 3) — fake = in-process test provider (no network).
# Real providers are added later and must read credentials from env, never hardcode.
MARKET_DATA_PROVIDER=fake
MARKET_DATA_SYMBOLS=
MARKET_DATA_HEARTBEAT_TIMEOUT_SECONDS=45
MARKET_DATA_RECONNECT_BASE_DELAY_SECONDS=0.5
MARKET_DATA_RECONNECT_MAX_DELAY_SECONDS=30
MARKET_DATA_CONNECT_TIMEOUT_SECONDS=10
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=10
MARKET_DATA_DROP_POLICY=drop_newest
MARKET_DATA_PERSIST_ENABLED=true
MARKET_DATA_HISTORICAL_MAX_CANDLES=10000
MARKET_DATA_HISTORICAL_PAGE_SIZE=1000

# -----------------------------------------------------------------------------
# Risk limits
# -----------------------------------------------------------------------------
RISK_ENGINE_REQUIRED=true
MAX_ORDER_QUANTITY=0
MAX_POSITION_QUANTITY=0
MAX_DAILY_LOSS=0
MAX_STRATEGY_LOSS=0
MAX_EXPOSURE=0
DUPLICATE_ORDER_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Execution safety
# -----------------------------------------------------------------------------
EXECUTION_ENGINE_ENABLED=false
PAPER_TRADING_ENABLED=false
ORDER_IDEMPOTENCY_REQUIRED=true
CANCEL_PENDING_ON_EMERGENCY_STOP=true
SQUARE_OFF_ON_EMERGENCY_STOP=false

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-local-dev-password
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
